{
  "productName": "FH Language Combo Tool",
  "version": "1.0.0",
  "identifier": "com.fhlanguagecombotool.app",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "FH Language Combo Tool",
        "width": 780,
        "height": 680,
        "resizable": true,
        "minWidth": 640,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
