{
  "productName": "FH Language Combo Tool",
  "version": "1.2.0",
  "identifier": "com.fhlanguagecombotool.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "FH Language Combo Tool",
        "width": 780,
        "height": 680,
        "resizable": true,
        "minWidth": 640,
        "minHeight": 520,
        "decorations": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
